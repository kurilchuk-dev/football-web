# Cloudflare Pages: https://developers.cloudflare.com/pages/configuration/headers/
# Files in /assets have a content hash in their name (JS, CSS, fonts), so they never
# change under the same URL and can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
